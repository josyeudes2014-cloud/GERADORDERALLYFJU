rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "admin@rallyfju.com";
    }

    match /configuracao/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /config/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /missoes/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /tribos/{triboId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(["pontos"]) &&
        request.resource.data.keys().hasOnly(resource.data.keys().union(["pontos"])) &&
        request.resource.data.pontos is number &&
        resource.data.pontos is number &&
        request.resource.data.pontos >= resource.data.pontos &&
        request.resource.data.pontos - resource.data.pontos <= 120
      );
    }

    match /jogos_registros/{docId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.pontos is number &&
        request.resource.data.pontos > 0 &&
        request.resource.data.pontos <= 120;
      allow update, delete: if isAdmin();
    }

    match /fcm_tokens/{docId} {
      allow read, delete: if isAdmin();
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /{document=**} {
      allow read, create, update, delete: if isAdmin();
    }
  }
}
