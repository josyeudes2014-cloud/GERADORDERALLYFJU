<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>RALLY FJU DO IDE</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com" rel="preconnect"/>
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;900&amp;family=Poppins:wght@400;700&amp;display=swap" rel="stylesheet"/>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --cor-principal: #00539f; --cor-secundaria: #003a70; --cor-destaque: #d52b1e;
            --cor-ouro: #ffd700; --cor-prata: #c0c0c0; --cor-bronze: #cd7f32;
        }
        .bg-principal { background-color: var(--cor-principal); } .text-principal { color: var(--cor-principal); }
        .border-principal { border-color: var(--cor-principal); } .bg-secundaria { background-color: var(--cor-secundaria); }
        .text-secundaria { color: var(--cor-secundaria); } .bg-destaque { background-color: var(--cor-destaque); } 
        .text-destaque { color: var(--cor-destaque); }
        .focus\:ring-principal:focus { --tw-ring-color: var(--cor-principal); }
        .text-principal { color: var(--cor-principal); }


        .font-montserrat { font-family: 'Montserrat', sans-serif; } .font-poppins { font-family: 'Poppins', sans-serif; }
        
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

        .animate-fadeIn { animation: fadeIn 0.5s ease-out forwards; }
        .animate-fadeInUp { animation: fadeInUp 0.6s ease-out forwards; }
        
        .podium-1 { order: 2; transform: translateY(-20px); z-index: 10; } 
        .podium-2 { order: 1; } 
        .podium-3 { order: 3; }

        .transition-all { transition: all 0.3s ease-in-out; }

        @keyframes text-glow {
            0%, 100% { text-shadow: 0 0 5px rgba(255, 255, 255, 0.4), 0 0 10px rgba(255, 255, 255, 0.3); }
            50% { text-shadow: 0 0 15px rgba(255, 255, 255, 0.7), 0 0 25px rgba(255, 255, 255, 0.5); }
        }
        .text-glow { animation: text-glow 4s ease-in-out infinite; }

        .tribo-card { transition: transform 0.3s ease, box-shadow 0.3s ease; }
        .tribo-card:hover { transform: translateY(-8px) scale(1.03); box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15); }
        
        .profile-photo-container {
            cursor: pointer;
            position: relative;
        }
        .profile-photo-overlay {
            position: absolute;
            inset: 0;
            background-color: rgba(0,0,0,0.5);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.3s;
            border-radius: 50%;
        }
        .profile-photo-container:hover .profile-photo-overlay {
            opacity: 1;
        }
    </style>
    <link href="manifest.json" rel="manifest"/>
    <meta content="#00539f" name="theme-color"/>
</head>
<body class="bg-gray-100 font-poppins text-gray-800">
    <script src="js/config.js"></script>
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.3/firebase-app.js";
        import { getAuth, signInWithEmailAndPassword, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/10.12.3/firebase-auth.js";
        import { getFirestore, doc, getDoc, setDoc, onSnapshot, collection, query, getDocs, addDoc, deleteDoc, writeBatch, where, orderBy, limit, updateDoc } from "https://www.gstatic.com/firebasejs/10.12.3/firebase-firestore.js";
        import { getStorage, ref, uploadBytes, getDownloadURL } from "https://www.gstatic.com/firebasejs/10.12.3/firebase-storage.js";

        const firebaseConfig = window.firebaseConfig;
        if (!firebaseConfig?.projectId || firebaseConfig.projectId !== "rallyfjuniteroi") {
            throw new Error("Configuração oficial do Firebase rallyfjuniteroi não foi carregada.");
        }
        let app, db, auth, storage;
        let isAdmin = false;
        let rallyConfig = {};
        
        const MISSOES_PADRAO = {
            1: `🛡️ SEMANA 1 (31 de Agosto a 06 de Setembro) 🛡️\n`+
               `TEMA: O CHAMADO DOS VALENTES\n`+
               `O início da batalha! É hora de mostrar a que viemos e começar com força total!\n`+
               `📅 MISSÕES SEMANAIS ⚔️\n\n`+
               `50: SEGUNDA (31/08) 🅰️➕ ALGO A MAIS: por jovem presente na reunião.\n`+
               `100: TERÇA (01/09) 🦶🏘️ PÉ NO BAIRRO (Evangelismo): por trabalho realizado (mínimo 3 jovens).\n`+
               `30: QUARTA (02/09) 📖 SALVAÇÃO DA ALMA: por jovem nas reuniões (7h, 10h, 12h, 15h, 19h30).\n`+
               `50: BÔNUS QUARTA: para quem for à reunião das 18h.\n`+
               `50: QUINTA (03/09) ❤️‍🔥 TERAPIA DO AMOR: por jovem presente às 19h.\n`+
               `20: SÁBADO (05/09) 📻 CONEXÃO JOVEM: por jovem conectado na rádio (11h30).\n`+
               `100: SÁBADO (05/09) 🎯 ENCONTRO JOVEM (EJ): por jovem novo (que nunca foi ao EJ).\n`+
               `60: SÁBADO (05/09) 🎯 ENCONTRO JOVEM (EJ): por jovem afastado que retornar.\n`+
               `150: DOMINGO (06/09) ⛪ CONCENTRAÇÃO DE FÉ: MISSÃO PRINCIPAL por jovem presente às 9h30!\n`+
               `75: DOMINGO (06/09) ⛪ CONCENTRAÇÃO DE FÉ: por jovem presente às 7h.\n\n`+
               `🔥 MISSÕES ESPECIAIS (BÔNUS ALTO!)\n\n`+
               `300: PONTO DE ORAÇÃO: Por tribo que organizar um momento de oração durante a semana.\n`+
               `1000: EVANGELIZAÇÃO CRIATIVA: Para a tribo que fizer uma ação evangelística inovadora.\n`+
               `2000: DESAFIO DOS VALENTES: Montar um time de futebol (mínimo 5 jogadores) e trazer no Encontro Jovem.\n`+
               `700: DOAÇÃO: Doar 1 resma de papel A4.\n`+
               `1000: MELHOR FOTO: A melhor foto da tribo (dentro ou fora da igreja).\n`+
               `300: MANUTENÇÃO DO TEMPLO: Por jovem que ajudar na limpeza no Sábado (8h30).\n`+
               `10000: META DA 1ª SEMANA: TRAZER 5 JOVENS NOVOS.`,
            2: `🛡️ SEMANA 2 (01 a 07 de Setembro) 🛡️\n` +
               `TEMA: A FORÇA DA UNIÃO\n` +
               `Uma tribo unida é imbatível! O foco é o trabalho em equipe e o cuidado uns com os outros.\n` +
               `📅 MISSÕES SEMANAIS ⚔️\n\n` +
               `60: SEGUNDA (01/09) 🅰️➕ ALGO A MAIS: por jovem presente.\n` +
               `100: BÔNUS SEGUNDA: para a tribo que levar um lanche para compartilhar.\n` +
               `120: TERÇA (02/09) 🦶🏘️ PÉ NO BAIRRO: por trabalho de evangelismo.\n` +
               `40: QUARTA (03/09) 📖 SALVAÇÃO DA ALMA: por jovem em qualquer reunião.\n` +
               `50: BÔNUS QUARTA: por jovem que trouxer um amigo convidado para o culto das 18h!\n` +
               `60: QUINTA (04/09) ❤️‍🔥 TERAPIA DO AMOR: por jovem presente às 19h.\n` +
               `30: SÁBADO (06/09) 📻 CONEXÃO JOVEM: por jovem conectado (11h30).\n` +
               `160: DOMINGO (07/09) 🎯 GRANDE ENCONTRO JOVEM (EJ): MISSÃO PRINCIPAL por jovem na Concentração de Fé às 9h30!\n` +
               `120: DOMINGO (07/09) 🎯 por jovem novo.\n` +
               `80: DOMINGO (07/09) 🎯 por jovem presente às 7h.\n` +
               `70: DOMINGO (07/09) 🎯 por jovem afastado que retornar.\n\n` +
               `🔥 MISSÕES ESPECIAIS (BÔNUS ALTO!)\n\n` +
               `1500: DESAFIO DOS VALENTES: Doar para a igreja 1 Vassoura de pelo, 1 Rodo e 2 Panos de Chão novos.\n` +
               `1200: VÍDEO DA TRIBO: Criar um vídeo de até 30s mostrando a união da tribo.\n` +
               `500: ANJO DA SEMANA: "Adotar" um jovem desanimado, dando atenção especial durante a semana.\n` +
               `1000: FOTO EM EQUIPE: A foto mais criativa com TODOS os membros da tribo fazendo um símbolo que represente a equipe.\n` +
               `12000: META DA 2ª SEMANA: TRAZER 7 JOVENS NOVOS.`,
            3: `🛡️ SEMANA 3 (08 a 14 de Setembro) 🛡️\n` +
               `TEMA: RAÍZES PROFUNDAS\n` +
               `O foco é o fortalecimento espiritual e o conhecimento da Palavra.\n` +
               `📅 MISSÕES SEMANAIS ⚔️\n\n` +
               `50: SEGUNDA (08/09) 🅰️➕ ALGO A MAIS: por jovem presente.\n` +
               `20: BÔNUS SEGUNDA: por jovem que levar sua Bíblia física.\n` +
               `150: TERÇA (09/09) 💌 EVANGELISMO: por ação de "Cartas de Esperança".\n` +
               `30: QUARTA (10/09) 📖 SALVAÇÃO DA ALMA: por jovem em qualquer reunião.\n` +
               `100: BÔNUS QUARTA: para a tribo que organizar uma oração de 5 minutos antes do culto das 18h!\n` +
               `50: QUINTA (11/09) ❤️‍🔥 TERAPIA DO AMOR: por jovem presente às 19h.\n` +
               `25: SÁBADO (13/09) 📻 CONEXÃO JOVEM: por jovem conectado.\n` +
               `150: DOMINGO (14/09) 🎯 GRANDE ENCONTRO JOVEM (EJ): MISSÃO PRINCIPAL por jovem na Concentração de Fé às 9h30!\n` +
               `100: DOMINGO (14/09) 🎯 por jovem novo.\n` +
               `75: DOMINGO (14/09) 🎯 por jovem presente às 7h.\n` +
               `60: DOMINGO (14/09) 🎯 por jovem afastado.\n\n` +
               `🔥 MISSÕES ESPECIAIS (BÔNUS ALTO!)\n\n` +
               `1500: DESAFIO DOS VALENTES: Doar 2 pacotes de Copos Descartáveis (200ml) e 1 pacote de Papel Higiênico (com 4 rolos).\n` +
               `1500: MEDITAR NA BÍBLIA: Reunir a tribo para meditar em um capítulo de Provérbios e entregar um resumo.\n` +
               `500: ORAÇÃO COM A TRIBO: Organizar um propósito de oração com a tribo.\n` +
               `700: FOTO "A GRAÇA NA PRÁTICA": A melhor foto representando um momento de AÇÃO PELAS ALMAS.\n` +
               `500: META DA 3ª SEMANA: GARANTIR QUE TODOS DA TRIBO PARTICIPEM DE PELO MENOS UM PONTO DE ORAÇÃO!`,
            4: `🛡️ SEMANA 4 (15 a 21 de Setembro) 🛡️\n` +
               `TEMA: CONECTADOS COM O REINO\n` +
               `Usando a criatividade e a tecnologia para evangelizar no mundo digital e além!\n` +
               `📅 MISSÕES SEMANAIS ⚔️\n\n` +
               `60: SEGUNDA (15/09) 🅰️➕ ALGO A MAIS: por jovem presente.\n` +
               `300: TERÇA (16/09) 💻 EVANGELISMO DIGITAL: para a tribo que criar um conteúdo evangelístico que alcance mais de 50 curtidas.\n` +
               `40: QUARTA (17/09) 📖 SALVAÇÃO DA ALMA: por jovem em qualquer reunião.\n` +
               `150: BÔNUS QUARTA: para a tribo que fizer uma live de 5 min no Instagram antes do culto das 18h!\n` +
               `70: QUINTA (18/09) ❤️‍🔥 TERAPIA DO AMOR: por jovem presente.\n` +
               `30: SÁBADO (20/09) 📻 CONEXÃO JOVEM: por jovem conectado.\n` +
               `50: BÔNUS SÁBADO: por postar um print nos stories marcando a FJU.\n` +
               `170: DOMINGO (21/09) 🎯 GRANDE ENCONTRO JOVEM (EJ): MISSÃO PRINCIPAL por jovem na Concentração de Fé às 9h30!\n` +
               `130: DOMINGO (21/09) 🎯 por jovem novo.\n` +
               `90: DOMINGO (21/09) 🎯 por jovem presente às 7h.\n` +
               `80: DOMINGO (21/09) 🎯 por jovem afastado.\n\n` +
